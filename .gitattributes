# dpkg 纯文本元数据：必须是 LF，否则 Sileo/Cydia 解析失败
Packages        text eol=lf
Packages.bz2    binary
Release         text eol=lf

# 脚本与网页
*.sh            text eol=lf
*.py            text eol=lf
*.html          text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.md            text eol=lf

# Theos / Logos 源码
*.x             text eol=lf
*.xm            text eol=lf
*.plist         text eol=lf
*.h             text eol=lf
*.m             text eol=lf
*.mm            text eol=lf
Makefile        text eol=lf
control         text eol=lf

# 二进制资产
*.deb           binary
*.png           binary
*.jpg           binary
*.mp3           binary